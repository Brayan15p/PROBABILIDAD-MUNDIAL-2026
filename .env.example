# ====== Proveedor deportivo (al menos uno recomendado; sin ellos el motor
# ====== opera sobre el Fallback Data Store embebido 2014-2022) ===========
# https://www.football-data.org/client/register  (gratuito, 10 req/min)
FOOTBALL_DATA_TOKEN=

# https://dashboard.api-football.com  (gratuito, 100 req/dia)
API_FOOTBALL_KEY=
# Solo si se usa la pasarela RapidAPI:
# API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# ====== Noticias (TIF). Sin keys, el TIF queda neutro = 1.0 ==============
# https://newsapi.org/register  (gratuito, 100 req/dia)
NEWSAPI_KEY=
# https://gnews.io  (gratuito, 100 req/dia)
GNEWS_KEY=

# ====== Historico Zafronix (opcional; sin URL se usa el dataset embebido) =
ZAFRONIX_BASE_URL=
ZAFRONIX_KEY=

# ====== Supabase (persistencia de predicciones y metricas) ===============
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa de solo-lectura para dashboards:
# SUPABASE_ANON_KEY=

# ====== Ajustes operacionales (opcionales, defaults documentados) ========
# WC26_MARKET_WEIGHT=0.5        # peso w del log-opinion pool con el mercado
# WC26_TTL_NEWS=43200           # TTL cache noticias (s)
# WC26_TTL_MARKET=900           # TTL cache mercado (s)
# WC26_NEWS_HALF_LIFE_H=72      # vida media del decaimiento de recencia
